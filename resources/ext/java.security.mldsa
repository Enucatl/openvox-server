# Experimental ordinary-provider configuration for OpenJDK 25; not FIPS.
# Append with -Djava.security.properties=/absolute/path/java.security.mldsa
# (one equals sign) so the runtime's algorithm restrictions remain in force.
# Provider selection must happen before Trapperkeeper/JRuby creates TLS contexts.
security.provider.1=org.bouncycastle.jsse.provider.BouncyCastleJsseProvider BC
security.provider.2=org.bouncycastle.jce.provider.BouncyCastleProvider
security.provider.3=SUN
security.provider.4=SunRsaSign
security.provider.5=SunEC
security.provider.6=SunJSSE
security.provider.7=SunJCE
security.provider.8=SunJGSS
security.provider.9=SunSASL
security.provider.10=XMLDSig
security.provider.11=SunPCSC
security.provider.12=JdkLDAP
security.provider.13=JdkSASL
security.provider.14=SunPKCS11
ssl.KeyManagerFactory.algorithm=PKIX
ssl.TrustManagerFactory.algorithm=PKIX
